; coq2py_core.ml/.mli are generated by `coqc Extract.v` in ../../coq/ and
; copied here by the top-level Makefile -- they are not hand-written and
; are not committed (see .gitignore); do not edit them directly.
; Extraction output isn't written with OCaml lint warnings in mind
; (e.g. harmless unused `rec` on single-clause definitions); suppress
; warnings-as-errors for it rather than hand-editing generated code.
; `coq-core.kernel` provides the `Float64`/`Uint63` runtime the extracted
; PrimFloat/Json.v float codec is realized against (see Extract.v's
; comment on ExtrOCamlFloats/ExtrOCamlInt63) -- already installed
; wherever `coqc` is (both machines per GOAL.md), not a new dependency.
(executable
 (name main)
 (libraries coq-core.kernel)
 (flags
  (:standard -w -a)))
