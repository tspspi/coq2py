# Top-level build orchestration.
#
# `coq2py_core.ml`/`.mli` (ocaml/driver/) are generated by coq/Extract.v,
# not hand-written, and are not committed to git -- see .gitignore. This
# Makefile is what wires "prove it in Coq" to "get a runnable OCaml tool"
# together; see GOAL.md for why that's two separate steps rather than one.
#
# Use `gmake` if your platform's default `make` is BSD make (coqc's own
# generated-makefile conventions assume GNU make).

.PHONY: all coq ocaml examples test clean

all: coq ocaml

coq:
	$(MAKE) -C coq extract

ocaml: coq
	cp coq/coq2py_core.ml coq/coq2py_core.mli ocaml/driver/
	cd ocaml && dune build

examples:
	cd coq && coqc -Q . "" -Q ../examples "" ../examples/Kinematics.v

test: ocaml
	@echo "--- running ocaml/driver smoke test against examples/Kinematics.v's term ---"
	echo -n '{"tag":"let","name":"v2","value":{"tag":"add","lhs":{"tag":"var","name":"v"},"rhs":{"tag":"mul","lhs":{"tag":"var","name":"a"},"rhs":{"tag":"var","name":"dt"}}},"body":{"tag":"add","lhs":{"tag":"var","name":"x"},"rhs":{"tag":"mul","lhs":{"tag":"var","name":"v2"},"rhs":{"tag":"var","name":"dt"}}}}' \
	  | (cd ocaml && dune exec driver/main.exe -- euler_step x,v,a,dt)

clean:
	$(MAKE) -C coq clean
	rm -f coq/coq2py_core.ml coq/coq2py_core.mli
	rm -f ocaml/driver/coq2py_core.ml ocaml/driver/coq2py_core.mli
	cd ocaml && dune clean
