# Top-level build orchestration.
#
# `coq2py_core.ml`/`.mli` (ocaml/driver/) are generated by coq/Extract.v,
# not hand-written, and are not committed to git -- see .gitignore. This
# Makefile is what wires "prove it in Coq" to "get a runnable OCaml tool"
# together; see GOAL.md for why that's two separate steps rather than one.
#
# Use `gmake` if your platform's default `make` is BSD make (coqc's own
# generated-makefile conventions assume GNU make).

.PHONY: all coq ocaml examples physics test wave_sim wave_sim_vec package clean

all: coq ocaml

coq:
	$(MAKE) -C coq extract

ocaml: coq
	cp coq/coq2py_core.ml coq/coq2py_core.mli ocaml/driver/
	cd ocaml && dune build

examples:
	cd coq && coqc -Q . "" -Q ../examples "" ../examples/Kinematics.v
	cd coq && coqc -Q . "" -Q ../examples "" ../examples/NaturalCoq.v
	cd coq && coqc -Q . "" -Q ../examples "" ../examples/Thermodynamics.v
	cd coq && coqc -Q . "" -Q ../examples "" ../examples/CoquelicotDemo.v

# examples/physics/ is a reusable collection of modules for a larger
# worked example (see docs/roadmap.md); it may grow to depend on the
# core coq/ modules (e.g. once it reaches the extraction stage), so both
# include paths are passed even though the current modules only need
# their own.
physics: coq
	coqc -Q coq "" -Q examples/physics "" examples/physics/Minkowski.v
	coqc -Q coq "" -Q examples/physics "" examples/physics/Calculus.v
	coqc -Q coq "" -Q examples/physics "" examples/physics/Maxwell.v
	coqc -Q coq "" -Q examples/physics "" examples/physics/Discretize.v

# Generates runtime/generated/leapfrog_update.py by piping the JSON
# encoding of examples/physics/Discretize.v's `leapfrog_update_expr`
# through the real coq2py CLI (byte-identical to that file's own
# `Compute print_expr leapfrog_update_expr`), then runs the external
# numpy/matplotlib runtime (runtime/wave1d.py) against it -- see that
# file's header for the trust-boundary split this represents.
LEAPFROG_UPDATE_JSON := {"tag":"fadd","lhs":{"tag":"fsub","lhs":{"tag":"fmul","lhs":{"tag":"fconst","kind":"finite","sign":false,"mantissa":4503599627370496,"exponent":-51},"rhs":{"tag":"var","name":"u_center"}},"rhs":{"tag":"var","name":"u_prev"}},"rhs":{"tag":"fmul","lhs":{"tag":"var","name":"r"},"rhs":{"tag":"fsub","lhs":{"tag":"fadd","lhs":{"tag":"var","name":"u_left"},"rhs":{"tag":"var","name":"u_right"}},"rhs":{"tag":"fmul","lhs":{"tag":"fconst","kind":"finite","sign":false,"mantissa":4503599627370496,"exponent":-51},"rhs":{"tag":"var","name":"u_center"}}}}}

wave_sim: ocaml
	mkdir -p runtime/generated
	echo -n '$(LEAPFROG_UPDATE_JSON)' \
	  | (cd ocaml && dune exec driver/main.exe -- leapfrog_update r,u_prev,u_left,u_center,u_right) \
	  > runtime/generated/leapfrog_update.py
	cd runtime && python3 wave1d.py

# The whole-grid step as one proven array term (slicing, broadcasting,
# concatenation -- examples/physics/Discretize.v's `one_pass_vec_expr`,
# byte-identical to that file's own `Compute print_expr` of it), through
# the same CLI, then runtime/wave1d_vec.py runs the full simulation on
# it and checks the final grid is bit-identical to wave1d.py's numpy
# path (hence the dependency: it needs leapfrog_update.py too).
ONE_PASS_VEC_JSON := {"tag":"app","func":{"tag":"app","func":{"tag":"app","func":{"tag":"lam","param":"r","body":{"tag":"lam","param":"curr","body":{"tag":"lam","param":"prev","body":{"tag":"let","name":"u_left","value":{"tag":"arrslice","arr":{"tag":"var","name":"curr"},"lo":{"tag":"const","value":0},"hi":{"tag":"const","value":-2}},"body":{"tag":"let","name":"u_center","value":{"tag":"arrslice","arr":{"tag":"var","name":"curr"},"lo":{"tag":"const","value":1},"hi":{"tag":"const","value":-1}},"body":{"tag":"let","name":"u_right","value":{"tag":"arrslice","arr":{"tag":"var","name":"curr"},"lo":{"tag":"const","value":2},"hi":{"tag":"arrlen","arr":{"tag":"var","name":"curr"}}},"body":{"tag":"let","name":"u_prev","value":{"tag":"arrslice","arr":{"tag":"var","name":"prev"},"lo":{"tag":"const","value":1},"hi":{"tag":"const","value":-1}},"body":{"tag":"let","name":"lr","value":{"tag":"arrmap2","x":"a","y":"b","body":{"tag":"fadd","lhs":{"tag":"var","name":"a"},"rhs":{"tag":"var","name":"b"}},"a":{"tag":"var","name":"u_left"},"b":{"tag":"var","name":"u_right"}},"body":{"tag":"let","name":"lap","value":{"tag":"arrmap2","x":"a","y":"b","body":{"tag":"fsub","lhs":{"tag":"var","name":"a"},"rhs":{"tag":"fmul","lhs":{"tag":"fconst","kind":"finite","sign":false,"mantissa":4503599627370496,"exponent":-51},"rhs":{"tag":"var","name":"b"}}},"a":{"tag":"var","name":"lr"},"b":{"tag":"var","name":"u_center"}},"body":{"tag":"let","name":"lead","value":{"tag":"arrmap2","x":"a","y":"b","body":{"tag":"fsub","lhs":{"tag":"fmul","lhs":{"tag":"fconst","kind":"finite","sign":false,"mantissa":4503599627370496,"exponent":-51},"rhs":{"tag":"var","name":"a"}},"rhs":{"tag":"var","name":"b"}},"a":{"tag":"var","name":"u_center"},"b":{"tag":"var","name":"u_prev"}},"body":{"tag":"let","name":"rlap","value":{"tag":"arrmap2","x":"a","y":"b","body":{"tag":"fmul","lhs":{"tag":"var","name":"a"},"rhs":{"tag":"var","name":"b"}},"a":{"tag":"var","name":"r"},"b":{"tag":"var","name":"lap"}},"body":{"tag":"let","name":"interior","value":{"tag":"arrmap2","x":"a","y":"b","body":{"tag":"fadd","lhs":{"tag":"var","name":"a"},"rhs":{"tag":"var","name":"b"}},"a":{"tag":"var","name":"lead"},"b":{"tag":"var","name":"rlap"}},"body":{"tag":"arrconcat","lhs":{"tag":"arrconst","elts":[{"tag":"fconst","kind":"zero","sign":false}]},"rhs":{"tag":"arrconcat","lhs":{"tag":"var","name":"interior"},"rhs":{"tag":"arrconst","elts":[{"tag":"fconst","kind":"zero","sign":false}]}}}}}}}}}}}}}}},"arg":{"tag":"var","name":"r"}},"arg":{"tag":"var","name":"curr"}},"arg":{"tag":"var","name":"prev"}}

wave_sim_vec: wave_sim
	mkdir -p runtime/generated
	echo -n '$(ONE_PASS_VEC_JSON)' \
	  | (cd ocaml && dune exec driver/main.exe -- one_pass_vec r,curr,prev) \
	  > runtime/generated/one_pass_vec.py
	cd runtime && python3 wave1d_vec.py

test: ocaml
	@echo "--- euler_step (pairs/tuples): examples/Kinematics.v's euler_step_expr ---"
	echo -n '{"tag":"let","name":"v2","value":{"tag":"add","lhs":{"tag":"var","name":"v"},"rhs":{"tag":"mul","lhs":{"tag":"var","name":"a"},"rhs":{"tag":"var","name":"dt"}}},"body":{"tag":"pair","fst":{"tag":"add","lhs":{"tag":"var","name":"x"},"rhs":{"tag":"mul","lhs":{"tag":"var","name":"v2"},"rhs":{"tag":"var","name":"dt"}}},"snd":{"tag":"var","name":"v2"}}}' \
	  | (cd ocaml && dune exec driver/main.exe -- euler_step x,v,a,dt)
	@echo "--- landed (comparisons/booleans): examples/Kinematics.v's landed_expr ---"
	echo -n '{"tag":"and","lhs":{"tag":"le","lhs":{"tag":"var","name":"x"},"rhs":{"tag":"const","value":0}},"rhs":{"tag":"lt","lhs":{"tag":"var","name":"v"},"rhs":{"tag":"const","value":0}}}' \
	  | (cd ocaml && dune exec driver/main.exe -- landed x,v)

# Stages exactly what ships to the remote deployment host (GOAL.md's
# "Target environments" table, docs/deployment.md for the full
# protocol): one binary, nothing else -- confirmed to have no runtime
# dependency beyond the OS's own libc/libm/libthr (`ldd` on the built
# `main.exe` shows nothing from `coq-core`/OCaml's own runtime: the
# `coq-core.kernel` library Extract.v's header explains is needed is a
# *link-time* cost only, statically compiled into the executable by
# `dune build`'s native-code default, not something the deployment
# host separately needs installed merely to *run* this binary -- it
# still needs `coqc`/`coq-core` for its own, separate job of
# type-checking the agent's proofs, per GOAL.md's target-environment
# table, just not to run this binary). Built at the `release` dune
# profile and stripped of debug info, since this is the artifact an
# actual host runs, not a dev-loop rebuild.
DIST_DIR := dist

package: coq
	cp coq/coq2py_core.ml coq/coq2py_core.mli ocaml/driver/
	cd ocaml && dune build --profile release
	mkdir -p $(DIST_DIR)
	rm -f $(DIST_DIR)/coq2py
	cp ocaml/_build/default/driver/main.exe $(DIST_DIR)/coq2py
	strip $(DIST_DIR)/coq2py
	cp docs/deployment.md $(DIST_DIR)/README.md
	@echo "Deployable artifact staged in $(DIST_DIR)/: coq2py (binary) + README.md"

clean:
	$(MAKE) -C coq clean
	rm -f coq/coq2py_core.ml coq/coq2py_core.mli
	rm -f ocaml/driver/coq2py_core.ml ocaml/driver/coq2py_core.mli
	cd ocaml && dune clean
	rm -rf $(DIST_DIR)
